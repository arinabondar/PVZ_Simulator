<Window x:Class="PVZ_Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ПВЗ Симулятор" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" 
        Background="#F5F5F5"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВОЕ МЕНЮ -->
        <Border Grid.Column="0" Background="#1976D2">
            <StackPanel Margin="10,30,10,10">
                <TextBlock Text="ПВЗ ЭКСПРЕСС" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button x:Name="BtnMenuIntake" Click="BtnNavIntake_Click" Margin="0,10" Height="45" Background="White" Foreground="#1976D2" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageDown" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Приемка" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMenuMap" Click="BtnNavMap_Click" Margin="0,10" Height="45" Background="#1565C0" Foreground="White" BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewGrid" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Карта склада" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMenuIssue" Click="BtnNavIssue_Click" Margin="0,10" Height="45" Background="#1565C0" Foreground="White" BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountArrowRight" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Выдача" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMenuLog" Click="BtnNavLog_Click" Margin="0,10" Height="45" Background="#1565C0" Foreground="White" BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Журнал" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMenuManual" Click="BtnNavManual_Click" Margin="0,10" Height="45" Background="#1565C0" Foreground="White" BorderBrush="Transparent" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Инструкция" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- РАБОЧАЯ ОБЛАСТЬ -->
        <Grid Grid.Column="1" Margin="30">

            <!-- ДАШБОРД -->
            <Grid VerticalAlignment="Top" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Background="#E3F2FD" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Всего заказов в базе" FontSize="14" Foreground="#1565C0"/>
                        <TextBlock Text="{Binding TotalOrders}" FontSize="28" FontWeight="Bold" Foreground="#0D47A1"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Background="#E8F5E9" Margin="10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Свободных ячеек" FontSize="14" Foreground="#2E7D32"/>
                        <TextBlock Text="{Binding FreeCells}" FontSize="28" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Background="#FFF3E0" Margin="10,0,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Выдано сегодня" FontSize="14" Foreground="#E65100"/>
                        <TextBlock Text="{Binding TodayIssued}" FontSize="28" FontWeight="Bold" Foreground="#BF360C"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- КОНТЕЙНЕР ДЛЯ ЭКРАНОВ -->
            <Grid Margin="0,90,0,0">

                <!-- ЭКРАН 1: ПРИЕМКА -->
                <Grid x:Name="ViewIntake" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Приемка" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,20,0"/>

                            <StackPanel>
                                <TextBlock Text="Фильтр" Foreground="#757575" Margin="0,0,0,2" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Width="140" Height="40" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Смоделировать" Click="BtnSimulate_Click" Height="40" Width="140" VerticalAlignment="Bottom" Margin="15,0,10,0"
                                    Background="#FF9800" Foreground="White" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold"/>

                            <Button Content="Списать &gt;10 дней" Click="BtnWriteOff_Click" Height="40" Width="150" VerticalAlignment="Bottom"
                                    Background="#F44336" Foreground="White" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="Поиск по ФИО/номеру" Foreground="#757575" Margin="0,0,0,2" FontSize="12"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="40" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ПОЛЯ ВВОДА С ПОДПИСЯМИ СВЕРХУ -->
                    <materialDesign:Card Grid.Row="1" Padding="20" UniformCornerRadius="8" Margin="0,0,0,15" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="ФИО Клиента" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtName" Height="40" VerticalContentAlignment="Center" Padding="10,0" Background="#FAFAFA"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Телефон (+375...)" Foreground="#757575" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtPhone" Height="40" VerticalContentAlignment="Center" Padding="10,0" Background="#FAFAFA"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                <TextBlock Text="Размер заказа" Foreground="#757575" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbSize" Height="40" VerticalContentAlignment="Center" Padding="10,0" Background="#FAFAFA">
                                    <ComboBoxItem Content="S (Мелкий)"/>
                                    <ComboBoxItem Content="M (Средний)"/>
                                    <ComboBoxItem Content="L (Крупный)"/>
                                </ComboBox>
                            </StackPanel>

                            <CheckBox x:Name="ChkFragile" Grid.Column="3" Content="Хрупкий" VerticalAlignment="Bottom" Margin="0,0,20,10" FontWeight="Bold" Foreground="#D32F2F"/>

                            <Button Grid.Column="4" Content="Принять" Click="BtnAddOrder_Click" Height="40" Width="120" VerticalAlignment="Bottom" Background="#4CAF50" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold"/>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="2" Padding="10" UniformCornerRadius="8">
                        <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="100"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="90"/>
                                <DataGridTextColumn Header="Ячейка" Binding="{Binding CellNumber}" Width="80"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                                <DataGridTextColumn Header="Дата приемки" Binding="{Binding ArrivalTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>

                <!-- ЭКРАН 2: КАРТА СКЛАДА -->
                <Grid x:Name="ViewMap" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Карта склада" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <materialDesign:Card Padding="20">
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="110" Height="110" Margin="8" CornerRadius="10" Background="{Binding StatusColor}" BorderBrush="#9E9E9E" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Cell_Click">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#424242"/>
                                                <TextBlock Text="{Binding Size}" FontSize="12" HorizontalAlignment="Center" Foreground="#757575" Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding CurrentOrder.Id}" FontSize="14" HorizontalAlignment="Center" Foreground="#D32F2F" FontWeight="Bold" Margin="5,0"/>
                                                <TextBlock Text="{Binding DaysOnShelfText}" FontSize="11" HorizontalAlignment="Center" Foreground="#616161" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </materialDesign:Card>
                    </ScrollViewer>
                </Grid>

                <!-- ЭКРАН 3: ВЫДАЧА -->
                <Grid x:Name="ViewIssue" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Выдача заказов" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                    <materialDesign:Card Grid.Row="1" Padding="40" UniformCornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                            <TextBlock Text="Введите номер заказа или телефон клиента:" FontSize="18" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <TextBox x:Name="TxtIssueId" FontSize="20" Margin="0,0,0,25" TextAlignment="Center" CharacterCasing="Upper" Height="50" VerticalContentAlignment="Center" Padding="10,0" Background="#FAFAFA"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Выдать" Click="BtnIssueOrder_Click" Margin="0,0,10,0" Height="60" Background="#1976D2" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" FontSize="18" FontWeight="Bold"/>
                                <Button Grid.Column="1" Content="Возврат" Click="BtnReturnOrder_Click" Margin="10,0,0,0" Height="60" Background="#F44336" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- ЭКРАН 4: ЖУРНАЛ -->
                <Grid x:Name="ViewLog" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Журнал операций" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Экспорт базы в CSV (Excel)" Click="BtnExport_Click" HorizontalAlignment="Right" Height="35" Background="#4CAF50" Foreground="White" 
                                materialDesign:ButtonAssist.CornerRadius="5" FontWeight="Bold"/>
                    </Grid>

                    <materialDesign:Card Grid.Row="1" Padding="10">
                        <ListBox ItemsSource="{Binding Logs}" FontSize="16" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </materialDesign:Card>
                </Grid>

                <!-- ЭКРАН 5: ИНСТРУКЦИЯ -->
                <Grid x:Name="ViewManual" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Инструкция пользователя" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                    <materialDesign:Card Grid.Row="1" Padding="30" UniformCornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Добро пожаловать в систему управления ПВЗ!" FontSize="20" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,15"/>

                                <TextBlock Text="1. Приемка посылок" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="• Введите ФИО, телефон (в формате +375...), выберите размер." TextWrapping="Wrap" Margin="10,0,0,5"/>
                                <TextBlock Text="• Ячейка подберется автоматически, в зависимости от размера." TextWrapping="Wrap" Margin="10,0,0,15"/>

                                <TextBlock Text="2. Карта склада" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="• Светло-зеленый цвет — ячейка свободна. Розово-красный — занята." TextWrapping="Wrap" Margin="10,0,0,5"/>
                                <TextBlock Text="• На плитке отображается номер заказа и сколько дней он лежит на складе." TextWrapping="Wrap" Margin="10,0,0,5"/>
                                <TextBlock Text="• Максимальный срок хранения — 10 дней. После этого посылку нужно вернуть." TextWrapping="Wrap" Margin="10,0,0,15"/>

                                <TextBlock Text="3. Выдача и Возврат" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="• Введите номер заказа или телефон клиента (можно просто цифры)." TextWrapping="Wrap" Margin="10,0,0,5"/>
                                <TextBlock Text="• Нажмите «Выдать», чтобы закрыть заказ и освободить ячейку." TextWrapping="Wrap" Margin="10,0,0,15"/>

                                <TextBlock Text="4. Фильтрация и Списание" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="• Используйте фильтр «Ожидают выдачи», чтобы видеть только актуальные заказы." TextWrapping="Wrap" Margin="10,0,0,5"/>
                                <TextBlock Text="• Кнопка «Списать >10 дней» автоматически оформит возврат для всех просроченных посылок." TextWrapping="Wrap" Margin="10,0,0,15"/>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>